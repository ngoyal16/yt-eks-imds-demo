# Copy to config.env and fill in. config.env is git-ignored.
# Use a dedicated sandbox account: the scripts refuse to run in any account but EXPECTED_ACCOUNT.
AWS_PROFILE=my-sandbox-profile
AWS_REGION=ap-south-1
EXPECTED_ACCOUNT=123456789012
# Optional: S3 bucket for step 5 (default: yt-eks-imds-demo-<account>-<region>)
# BUCKET=
